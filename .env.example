# Copy this file to .env and fill in only the keys for the engines you use.
# .env is git-ignored; never commit real keys.
# The default engine (edge, free Microsoft voices) needs no keys at all.

# --engine gemini: Gemini 3.8 TTS through the Gemini API
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --engine openrouter: the same Gemini TTS models through OpenRouter (requires OpenRouter credits)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --engine google-cloud: Google Cloud Text-to-Speech (Chirp 3 HD and Gemini-TTS models)
# Path to a service account JSON key; relative paths resolve against the folder holding this .env file.
# Keep key files in the git-ignored credentials/ folder.
GOOGLE_APPLICATION_CREDENTIALS=credentials/your-service-account-key.json
